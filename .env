# Canonical origin used for canonical URLs, sitemap, robots and social metadata.
VITE_SITE_ORIGIN=https://dicom.camera
# Preview/staging builds are non-indexable. `npm run build:production` sets this to true.
VITE_INDEXABLE=false
# Optional real form endpoint for the contact page. Leave empty to use the email routes only.
VITE_CONTACT_FORM_ENDPOINT=
