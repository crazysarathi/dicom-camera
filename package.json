{
  "name": "dicom-camera-website",
  "private": true,
  "version": "1.1.0",
  "description": "Commercial product website for DICOM Camera (dicom.camera). Static, prerendered React site.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "images": "node scripts/build-images.mjs",
    "documents": "node scripts/build-documents.mjs",
    "documents:pdf": "node scripts/build-documents.mjs --pdf",
    "build": "npm run images && npm run documents && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:production": "cross-env VITE_INDEXABLE=true npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint:content": "node scripts/check-content.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
